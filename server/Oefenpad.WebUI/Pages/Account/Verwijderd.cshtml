@page
@model Oefenpad.WebUI.Pages.Account.VerwijderdModel
@{
    ViewData["TitelNl"] = "Account verwijderd — Oefenpad";
    ViewData["TitelEn"] = "Account deleted — Oefenpad";
}

<header class="kop">
    <h1>@Html.Beide("Je account is verwijderd", "Your account has been deleted")</h1>
    <div class="kant">
        <p>@Html.Beide(
            "Bedankt voor het oefenen. Je kunt altijd opnieuw beginnen.",
            "Thank you for practising. You can always start again.")</p>
    </div>
</header>

<main class="account">
    <section class="formulier">
        <p>
            <a class="knop oranje" href="/">@Html.Beide("Naar de oefeningen", "Go to the exercises")</a>
        </p>
        <p>
            <a href="/Account/Registreren">@Html.Beide("Opnieuw een account maken", "Create an account again")</a>
        </p>
    </section>

    <aside class="zij">
        <h2>@Html.Beide("Privacy", "Privacy")</h2>
        <p>@Html.Beide(
            "Je gegevens zijn verwijderd. Wat er precies bewaard blijft, staat in het privacybeleid.",
            "Your data has been deleted. The privacy policy explains exactly what is kept.")</p>
        <a class="knop leeg klein" href="/privacy.html">Privacy</a>
    </aside>
</main>
