@page
@model Oefenpad.WebUI.Pages.Account.BevestigOpnieuwModel
@{
    ViewData["TitelNl"] = "Bevestigingslink opnieuw — Oefenpad";
    ViewData["TitelEn"] = "Resend confirmation — Oefenpad";
}

<header class="kop">
    <h1>@Html.Beide("Link opnieuw sturen", "Send a new link")</h1>
    <div class="kant">
        <p>@Html.Beide(
            "Vul het adres in waarmee je je hebt geregistreerd.",
            "Enter the address you registered with.")</p>
    </div>
</header>

<main class="account">
    <section class="formulier">
        @Html.Meldingen(Model.Gelukt, "goed")
        @Html.Meldingen(Model.Fouten)

        @if (!Model.Verzonden)
        {
            <form method="post">
                <div class="@Model.VeldClass("Email")">
                    <label asp-for="Email">@Html.Beide("E-mailadres", "Email address")</label>
                    <input asp-for="Email" type="email" autocomplete="email" inputmode="email" />
                </div>

                <div class="acties">
                    <button class="knop oranje" type="submit">@Html.Beide("Stuur de link", "Send the link")</button>
                </div>
            </form>
        }
        else
        {
            <p>
                <a class="knop leeg" href="/Account/Inloggen">@Html.Beide("Naar inloggen", "Go to sign in")</a>
            </p>
        }
    </section>

    <aside class="zij">
        <h2>@Html.Beide("Niets ontvangen?", "Nothing received?")</h2>
        <p>@Html.Beide(
            "Kijk ook in je spamfolder. De link blijft 24 uur geldig.",
            "Check your spam folder too. The link stays valid for 24 hours.")</p>
    </aside>
</main>
