<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Oefenpad.WebUI</RootNamespace>
    <AssemblyName>Oefenpad.WebUI</AssemblyName>
    <UserSecretsId>aspnet-Oefenpad-1f9f4e1b-9e4d-4b18-a6e0-4d6d8b1c2a71</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ==================================================================
       The React games are built from ../../client and land in this
       project's wwwroot/spelen. Vite is not part of the .NET toolchain,
       so the build is driven from here: `dotnet build` refreshes the
       bundle when the client sources changed, and publish carries it.

       Pass -p:SkipClientBuild=true to build without npm (offline, or a
       machine without Node). The fallback is then whatever is already
       in wwwroot/spelen.
       ================================================================== -->
  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)/../../client</ClientDir>
    <ClientBuildOutput>$(MSBuildProjectDirectory)/wwwroot/spelen</ClientBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ClientSource Include="$(ClientDir)/src/**/*;$(ClientDir)/scripts/**/*" />
    <ClientSource Include="$(ClientDir)/index.html;$(ClientDir)/package.json;$(ClientDir)/package-lock.json;$(ClientDir)/tsconfig.json;$(ClientDir)/vite.config.ts" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated. Kept out of the default wwwroot content glob because the
         file names are hashed and only known after the npm build. -->
    <Content Remove="wwwroot/spelen/**" />
  </ItemGroup>

  <Target Name="ClientDependencies"
          BeforeTargets="ClientBuild"
          Condition="'$(SkipClientBuild)' != 'true' and !Exists('$(ClientDir)/node_modules')">
    <Message Importance="high" Text="Installing game dependencies (npm ci)…" />
    <Exec Command="npm ci" WorkingDirectory="$(ClientDir)" />
  </Target>

  <Target Name="ClientBuild"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipClientBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(ClientSource)"
          Outputs="$(ClientBuildOutput)/index.html">
    <Message Importance="high" Text="Building the games (npm run build)…" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />
  </Target>

  <!-- The default wwwroot glob cannot see files that appear mid-build, so
       the bundle is added to the publish list after the npm build ran. -->
  <Target Name="ClientPublishFiles"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="ClientBuild">
    <ItemGroup>
      <ClientBuiltFile Include="$(ClientBuildOutput)/**/*" />
      <ResolvedFileToPublish Include="@(ClientBuiltFile)">
        <RelativePath>wwwroot/spelen/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Oefenpad.Contracts\Oefenpad.Contracts.csproj" />
    <ProjectReference Include="..\Oefenpad.DB\Oefenpad.DB.csproj" />
    <ProjectReference Include="..\Oefenpad.DTOs\Oefenpad.DTOs.csproj" />
    <ProjectReference Include="..\Oefenpad.Enums\Oefenpad.Enums.csproj" />
    <ProjectReference Include="..\Oefenpad.Resources\Oefenpad.Resources.csproj" />
    <ProjectReference Include="..\Oefenpad.Services\Oefenpad.Services.csproj" />
    <ProjectReference Include="..\Oefenpad.Validation\Oefenpad.Validation.csproj" />
  </ItemGroup>

</Project>
