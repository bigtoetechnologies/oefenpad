<Project>
  <!-- Fix for EF Core tools generating Windows-style backslash paths on Linux.
       Must be set before Microsoft.Common.props is imported. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
